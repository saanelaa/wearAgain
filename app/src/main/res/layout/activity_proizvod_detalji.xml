<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadina_detalji">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivSlika"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground"
            app:layout_constraintTop_toTopOf="parent"/>

        <Button
            android:id="@+id/btnNazad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Nazad"
            android:backgroundTint="@color/boja_dugmadi_negativno"
            android:textColor="@color/white"
            android:layout_margin="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvNaziv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/boja_slova_okvira"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/ivSlika"/>

        <TextView
            android:id="@+id/tvCijena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/info_proizvoda"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvNaziv"/>

        <TextView
            android:id="@+id/tvKategorija"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/info_proizvoda"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvCijena"/>

        <TextView
            android:id="@+id/tvVelicina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/info_proizvoda"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvKategorija"/>

        <TextView
            android:id="@+id/tvLokacija"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/info_proizvoda"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvVelicina"/>

        <TextView
            android:id="@+id/tvOpis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/boja_slova_okvira"
            android:padding="16dp"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/tvLokacija"/>

        <TextView
            android:id="@+id/tvProdavac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/info_proizvoda"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvOpis"/>

        <Button
            android:id="@+id/btnDodajUKorpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dodaj u korpu 🛒"
            android:backgroundTint="@color/boja_dugmadi_pozitivno"
            android:textColor="@color/white"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvProdavac"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnMojaObjava"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uredi objavu"
            android:backgroundTint="@color/boja_dugmadi_negativno"
            android:textColor="@color/white"
            android:visibility="gone"
            android:layout_margin="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnDodajUKorpu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>